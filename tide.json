{
  "$schema": "https://tide.local/schema.json",
  "model": "llama3.1:8b",
  "ollama": {
    "host": "http://localhost:11434",
    "timeout": 120
  },
  "tools": {
    "bash": {
      "require_confirmation": true,
      "timeout": 30,
      "allowed_commands": ["ls", "cat", "grep", "find", "git", "python3"]
    },
    "ls": {
      "max_depth": 5,
      "max_files": 1000,
      "ignore": [".git", "node_modules", "__pycache__", ".venv"]
    },
    "edit": {
      "create_backup": true,
      "show_diff": true
    },
    "grep": {
      "max_results": 100,
      "context_lines": 3
    }
  },
  "ui": {
    "theme": "blue",
    "syntax_theme": "monokai",
    "show_line_numbers": true,
    "auto_refresh": true
  },
  "permissions": {
    "confirm_write": true,
    "confirm_delete": true,
    "confirm_bash": true,
    "allow_outside_working_dir": false
  },
  "recommended_models": {
    "llama3.1:8b": {
      "name": "Llama 3.1 (8B)",
      "description": "Best coding performance, large context window",
      "size": "4.9 GB",
      "recommended": true
    },
    "qwen3:latest": {
      "name": "Qwen 3",
      "description": "Excellent code generation and reasoning",
      "size": "4-8 GB",
      "recommended": true
    },
    "codellama:latest": {
      "name": "CodeLlama",
      "description": "Specialized for code tasks",
      "size": "4-8 GB",
      "recommended": true
    }
  }
}
