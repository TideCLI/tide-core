#!/usr/bin/env python3
"""
Tide Model Manager - Download and manage Ollama models
This tool is included in Tide OS ISO for offline model management
"""

import os
import sys
import json
import subprocess
import argparse
from typing import List, Dict, Optional
from pathlib import Path


# ANSI Colors
class Colors:
    CYAN = '\033[0;36m'
    GREEN = '\033[0;32m'
    YELLOW = '\033[1;33m'
    RED = '\033[0;31m'
    BLUE = '\033[0;34m'
    RESET = '\033[0m'
    BOLD = '\033[1m'


